PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/purrconnect
CLIENT_URL=http://localhost:5173

# --- Auth ---
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

# --- Used ONLY by `npm run create-admin` (choose your own values) ---
# Remove ADMIN_PASSWORD from your .env after the admin is created.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Used ONLY by `npm run create-test-user` (non-admin, for testing 403 responses) ---
TEST_USER_NAME=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
